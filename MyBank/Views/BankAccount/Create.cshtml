@model BankSystem.ViewModel.AccountCreateVM

@{
    ViewData["Title"] = "Open New Account";
}

<h2>Open New Account</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="CustomerId" class="control-label">Customer</label>
                <select asp-for="CustomerId" class="form-control" asp-items="@(new SelectList(ViewBag.Customers, "Id", "FullName"))">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="InitialBalance" class="control-label"></label>
                <input asp-for="InitialBalance" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="InitialBalance" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create Account" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
