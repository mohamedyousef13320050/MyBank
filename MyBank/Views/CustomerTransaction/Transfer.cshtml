@model BankSystem.ViewModel.TransferVM

@{
    ViewData["Title"] = "Transfer Funds";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-4 shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Transfer Funds</h5>
            </div>
            <div class="card-body p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                <form asp-action="Transfer">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="FromAccountId" class="control-label fw-bold">Transfer From (Your Account)</label>
                        <select asp-for="FromAccountId" class="form-select" asp-items="@(new SelectList(ViewBag.MyAccounts, "Id", "AccountNumber"))">
                            <option value="">-- Select Source Account --</option>
                        </select>
                        <span asp-validation-for="FromAccountId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ToAccountNumber" class="control-label fw-bold">Transfer To (Account Number)</label>
                        <input asp-for="ToAccountNumber" class="form-control form-control-lg text-center" placeholder="e.g. 1234567890" />
                        <span asp-validation-for="ToAccountNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="control-label fw-bold"></label>
                        <input asp-for="Amount" class="form-control form-control-lg text-center text-success" type="number" step="0.01" min="0.01" placeholder="0.00" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Description" class="control-label fw-bold"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg" onclick="return confirm('Are you sure you want to transfer this amount?');">
                            Confirm Transfer
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light p-3 text-center">
                <a asp-controller="CustomerAccount" asp-action="Index" class="btn btn-link text-secondary text-decoration-none">Cancel & Back to My Accounts</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
