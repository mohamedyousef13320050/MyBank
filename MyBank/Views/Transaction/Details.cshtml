@model BankSystem.ViewModel.TransactionDetailsVM

@{
    ViewData["Title"] = "Transaction Details";
}

<h2>Transaction Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Account Number</dt>
    <dd class="col-sm-9">@Model.AccountNumber</dd>

    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.Type</dd>

    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">@Model.Amount</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Date</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>
