@model IEnumerable<BankSystem.ViewModel.CustomerListVM>

@{
    ViewData["Title"] = "Customer Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Customer Management</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Create New Customer
    </a>
</div>
<hr />

<div class="row mb-4">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <div class="input-group">
                <input type="text" 
                       name="searchString" 
                       value="@Context.Request.Query["searchString"]" 
                       class="form-control" 
                       placeholder="Search by name, national ID, or phone..." />
                <button type="submit" class="btn btn-outline-primary">Search</button>
                @if (!string.IsNullOrEmpty(Context.Request.Query["searchString"]))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                <th>@Html.DisplayNameFor(model => model.NationalId)</th>
                <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th style="width: 280px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.FullName</td>
                        <td>@customer.NationalId</td>
                        <td>@customer.PhoneNumber</td>
                        <td>
                            @if (customer.Status)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-warning btn-sm">Edit</a>
                                @if (customer.Status)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@customer.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to deactivate this customer?')">Deactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@customer.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Are you sure you want to activate this customer?')">Activate</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        No customers found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
