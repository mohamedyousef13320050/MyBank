@model BankSystem.ViewModel.CustomerDetailsVM

@{
    ViewData["Title"] = "Customer Details";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@Model.FullName</h4>
                @if (Model.Status)
                {
                    <span class="badge bg-success fs-6">Active</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Inactive</span>
                }
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.FullName)</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.NationalId)</dt>
                    <dd class="col-sm-8">@Model.NationalId</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.DateOfBirth)</dt>
                    <dd class="col-sm-8">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Address)</dt>
                    <dd class="col-sm-8">@Model.Address</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Status)</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status)
                        {
                            <span class="badge bg-success">Active Account</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Deactivated Account</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                <div>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                    @if (Model.Status)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to deactivate this customer?')">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to activate this customer?')">Activate</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
